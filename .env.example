# WariMCP v2 — Environment Variables

# === Mode ===
# mock = deterministic test responses (no API keys needed)
# sandbox = use provider sandbox APIs
# live = production
WARIMCP_MODE=mock

# === Transport ===
# stdio = MCP only (for AI agent registration)
# http = Express REST API only (for Docker)
# both = MCP + HTTP (local dev)
WARIMCP_TRANSPORT=both

# === Server ===
WARIMCP_PORT=3000

# === Database ===
DATABASE_URL=postgresql://warimcp:changeme@localhost:5432/warimcp
DB_PASSWORD=changeme

# === CinetPay (Phase 1) ===
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# === Wave (Phase 1) ===
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# === Hub2 / Ecobank (Phase 2) ===
HUB2_API_KEY=

# === PAPSS (Phase 3) ===
PAPSS_API_KEY=

# === Flutterwave ===
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# === KKiaPay ===
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=

# === Moneroo (meta-aggregator) ===
MONEROO_SECRET_KEY=

# === FedaPay ===
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=

# === MTN MoMo ===
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=

# === Webhook ===
# Base URL for inbound provider webhooks (e.g. https://warimcp.yourdomain.com)
WARIMCP_WEBHOOK_BASE_URL=
# Secret for signing outbound relay events (HMAC-SHA256)
WARIMCP_RELAY_SECRET=

# === x402 pay-per-call billing (optional) ===
# When true, requests WITHOUT an X-Api-Key can pay per call in USDC via x402.
# API-key customers are unaffected. Default: false.
X402_ENABLED=false
# Wallet address that receives the USDC (REQUIRED when enabled)
X402_PAY_TO=
# Base mainnet: eip155:8453 | Base Sepolia (testing): eip155:84532
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://facilitator.x402.org
# Per-call prices (money format, converted to USDC by the middleware)
X402_PRICE_WRITE=$0.02
X402_PRICE_READ=$0.005
# Sync payment kinds from the facilitator (required for 402 challenges; only false in tests)
X402_SYNC_ON_START=true

# === EURC (second x402 settlement asset; XOF is euro-pegged) ===
X402_ACCEPT_EURC=false
# Leave empty for built-in Base/Base-Sepolia addresses; verify before mainnet.
X402_EURC_ASSET=
X402_EURC_PRICE_WRITE=0.017
X402_EURC_PRICE_READ=0.004

# === Provider failover chain ===
# Tried in order when the requested provider fails safely (4xx only — 5xx and
# network errors never fail over: the payment may already exist there).
WARIMCP_FAILOVER_CHAIN=fedapay

# === Prepaid mobile-money credits (billing door 3) ===
# API keys with a credit account are charged per call in XOF; top-ups collected
# through WariMCP itself on YOUR provider account (dogfooding).
BILLING_PREPAID_ENABLED=false
BILLING_PRICE_WRITE_XOF=15
BILLING_PRICE_READ_XOF=3
BILLING_TOPUP_MIN_XOF=500
BILLING_TOPUP_PROVIDER=fedapay
