# WariMCP v2 — Environment Variables

# === Mode ===
# mock = deterministic test responses (no API keys needed)
# sandbox = use provider sandbox APIs
# live = production
WARIMCP_MODE=mock

# === Transport ===
# stdio = MCP only (for AI agent registration)
# http = Express REST API only (for Docker)
# both = MCP + HTTP (local dev)
WARIMCP_TRANSPORT=both

# === Server ===
WARIMCP_PORT=3000

# === Database ===
DATABASE_URL=postgresql://warimcp:changeme@localhost:5432/warimcp
DB_PASSWORD=changeme

# === CinetPay (Phase 1) ===
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# === Wave (Phase 1) ===
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# === Hub2 / Ecobank (Phase 2) ===
HUB2_API_KEY=

# === PAPSS (Phase 3) ===
PAPSS_API_KEY=

# === Flutterwave ===
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# === KKiaPay ===
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=

# === Moneroo (meta-aggregator) ===
MONEROO_SECRET_KEY=

# === FedaPay ===
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=

# === MTN MoMo ===
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=

# === Webhook ===
# Base URL for inbound provider webhooks (e.g. https://warimcp.yourdomain.com)
WARIMCP_WEBHOOK_BASE_URL=
# Secret for signing outbound relay events (HMAC-SHA256)
WARIMCP_RELAY_SECRET=

# === Manual Payment Collection (pre-RCCM) ===
# ⚠️ DISABLED BY DEFAULT. Setting this to "true" routes customer funds into a
# personal Wave/OM account with SMS reconciliation — unlicensed payment collection
# under BCEAO Instruction n°001-01-2024. Do NOT enable for real-money use without
# a licensed PSP in the loop. Only the literal "true" enables it. See ROADMAP.md.
MANUAL_PAYMENT_COLLECTION_ENABLED=false
MANUAL_PAYMENT_WAVE_NUMBER=
MANUAL_PAYMENT_OM_NUMBER=
MANUAL_PAYMENT_WHATSAPP_NOTIFY=
MANUAL_PAYMENT_SMS_SECRET=
