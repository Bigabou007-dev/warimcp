{
  "name": "warimcp",
  "version": "2.0.0",
  "description": "WariMCP — AI-native payment MCP server for West Africa. Unified gateway for CinetPay, Wave, Hub2/Ecobank, and PAPSS payment rails.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-api-key": "tsx src/db/seed-api-key.ts"
  },
  "keywords": [
    "mcp",
    "payments",
    "west-africa",
    "cinetpay",
    "wave",
    "flutterwave",
    "fintech",
    "africa",
    "uemoa",
    "papss"
  ],
  "author": "Bigabou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bigabou007-dev/warimcp.git"
  },
  "homepage": "https://github.com/Bigabou007-dev/warimcp#readme",
  "bugs": {
    "url": "https://github.com/Bigabou007-dev/warimcp/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "postgres": "^3.4.7",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
